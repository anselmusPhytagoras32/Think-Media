# Placeholder-only example. Copy to .env (git-ignored) and replace every value.
# Never commit a real password, secret or deployment URL.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://thinkmedia:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/thinkmedia

# Comma-separated exact origins allowed on POST/PATCH. Add the Vite dev origin
# or the deployed HTTPS origin; do not use "*".
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for multi-process deployments (all workers must share the same value).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_CSRF_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Session/CSRF defaults (optional).
APP_SESSION_TTL_HOURS=8
APP_SESSION_COOKIE_NAME=tm_session
# Leave unset to require Secure outside local/test/development, or set explicitly.
# APP_COOKIE_SECURE=true
# APP_CSRF_HEADER_NAME=X-CSRF-Token
# APP_MAX_REQUEST_BODY_BYTES=65536

# Authentication throttles (per process; see README limitations).
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_WINDOW_SECONDS=900
APP_REGISTER_MAX_ATTEMPTS=20
APP_REGISTER_WINDOW_SECONDS=3600

# Only enable when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Otherwise clients could spoof throttle keys.
APP_TRUSTED_PROXY_HEADERS=false

# FR10: default disabled. 'retrieval' enables deterministic approved excerpts,
# not an external LLM. Never place runtime provider secrets in the frontend.
APP_ASSISTANT_MODE=disabled
APP_ASSISTANT_MAX_REQUESTS=10
APP_ASSISTANT_WINDOW_SECONDS=60

# FR08: default profile-only. Change only after a real held-out validation.
APP_RECOMMENDER_ALPHA=1
