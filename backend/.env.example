# Placeholder-only example. Copy to .env (git-ignored) and replace every value.
# Never commit a real password, secret or deployment URL.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://thinkmedia:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/thinkmedia

# Comma-separated exact origins allowed on POST/PATCH. Add the Vite dev origin
# or the deployed HTTPS origin; do not use "*".
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for multi-process deployments (all workers must share the same value).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_CSRF_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Session/CSRF defaults (optional).
APP_SESSION_TTL_HOURS=8
APP_SESSION_COOKIE_NAME=tm_session
# Leave unset to require Secure outside local/test/development, or set explicitly.
# APP_COOKIE_SECURE=true
# APP_CSRF_HEADER_NAME=X-CSRF-Token
# APP_MAX_REQUEST_BODY_BYTES=65536

# Authentication throttles (per process; see README limitations).
APP_LOGIN_MAX_FAILURES=5
APP_LOGIN_WINDOW_SECONDS=900
APP_REGISTER_MAX_ATTEMPTS=20
APP_REGISTER_WINDOW_SECONDS=3600

# Only enable when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Otherwise clients could spoof throttle keys.
APP_TRUSTED_PROXY_HEADERS=false

# FR10: default disabled. 'retrieval' enables deterministic approved excerpts,
# not an external LLM. Never place runtime provider secrets in the frontend.
APP_ASSISTANT_MODE=disabled
APP_ASSISTANT_MAX_REQUESTS=10
APP_ASSISTANT_WINDOW_SECONDS=60

# FR10: optional live integration. Use external only after selecting an approved
# provider/model and configuring a server-only key outside Git. Never put the
# key in VITE_* variables. No key is supplied by Codex login.
# Selected optional provider: Gemini 3.8 Flash, through Google's compatibility API.
# This selection alone makes no request; disabled mode and zero budget remain.
APP_ASSISTANT_PROVIDER_PROFILE=gemini
# APP_ASSISTANT_MODE=external
# Blank Gemini endpoint/model automatically use these verified defaults:
# APP_ASSISTANT_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# APP_ASSISTANT_MODEL=gemini-3.8-flash
# APP_ASSISTANT_API_KEY=REPLACE_IN_PRIVATE_ENVIRONMENT_ONLY
# Gemini 3.8 supports low/medium/high, not minimal or thinking-off.
# This profile omits store/n, uses max_tokens, and requests JSON schema.
APP_ASSISTANT_REASONING_EFFORT=low
# To use an OpenAI-compatible provider instead, select profile=openai and set its
# endpoint/model/key explicitly. That profile uses max_completion_tokens/store.
APP_ASSISTANT_TIMEOUT_SECONDS=10
APP_ASSISTANT_MAX_COMPLETION_TOKENS=512
# Gemini's cap includes thinking; a truncated response fails safely. Increase
# only deliberately after reviewing provider cost limits; see docs/AI_SETUP.md.
# Zero prevents external calls until the operator explicitly allocates a budget.
# Counts all attempted calls (including failures) for this process lifetime.
# Restarts reset it; each worker has its own budget. This is NOT a currency cap.
# Set provider account spending limits too. No redirects or automatic retries.
APP_ASSISTANT_CALL_BUDGET=0

# FR08: default profile-only. Change only after a real held-out validation.
APP_RECOMMENDER_ALPHA=1
