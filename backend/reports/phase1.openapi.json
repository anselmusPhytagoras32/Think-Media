            "description": "Administrator privileges required or CSRF check failed."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Company not found."
          },
          "409": {
